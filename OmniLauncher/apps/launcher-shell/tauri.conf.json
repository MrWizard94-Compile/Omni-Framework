{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniLauncher",
  "version": "0.1.0",
  "identifier": "net.wpaistudio.omnilauncher",
  "build": {
    "frontendDist": "../launcher-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../launcher-ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../launcher-ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "OmniLauncher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png"],
    "copyright": "Copyright © 2026 Wizard Productions AI Studio",
    "shortDescription": "Minecraft launcher for the Omni-Framework",
    "longDescription": "OmniLauncher manages Minecraft: Java Edition instances, accounts, and mods for the Omni-Framework. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft."
  }
}
