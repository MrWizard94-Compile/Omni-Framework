# ── Omni-Framework .gitignore ──────────────────────────────────────────────
# Vivisection corpus: shallow clones of subject repos. Rebuilt deterministically
# by intelligence/tools/ingest.py from pinned commits — never committed.
intelligence/corpus/

# Intelligence database: build artifact, rebuilt deterministically from
# intelligence/analysis/*.toml + schema.sql (see ADR-0004).
intelligence/omni_intel.db
intelligence/omni_intel.db-journal
intelligence/omni_intel.db-wal
intelligence/omni_intel.db-shm

# Phase 6 census (ADR-0022): network-sourced, resumable; not committed.
intelligence/omni_census.db
intelligence/omni_census.db-journal
intelligence/omni_census.db-wal
intelligence/omni_census.db-shm
intelligence/census/ranked.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rust (OmniLauncher core — Phase 4)
target/

# Node (OmniLauncher UI — Phase 4)
node_modules/
dist/

# Tauri build artifacts (schemas/plugin manifests regenerated by tauri-build)
OmniLauncher/apps/launcher-shell/gen/

# Local meta snapshots and generated trees (docs/FIRST_RUN.md writes these at the
# repo root). Both are deterministic build artifacts rebuilt by omni-meta-gen, and
# the snapshot is a copy of Mojang's data — neither belongs in the repository.
/meta-snapshot/
/meta-tree/
/plan.txt
/upload.sh

# Java/Gradle (OmniLoader — Phase 4)
build/
.gradle/

# OS / editor artifacts
Thumbs.db
Desktop.ini
*.swp
*~
.DS_Store

# Scratch data from the server_smoke example (real game artifacts, never committed).
server-smoke-data/

# The staged loader distribution (build artifact, reproducible from the module).
OmniLoader/*/build/loader-dist/
